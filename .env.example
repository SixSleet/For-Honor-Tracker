# Optional Steam Web API key (adds owned-game/playtime data)
STEAM_API_KEY=

# Ubisoft UbiServices provider
UBISOFT_ENABLED=false
UBISOFT_TICKET=
UBISOFT_SESSION_ID=
UBISOFT_EMAIL=
UBISOFT_PASSWORD=

# Public Ubisoft client identifier used as Ubi-AppId
UBISOFT_APP_ID=f35adcb5-1911-440c-b1c9-48fdc1701c68
UBISOFT_FORHONOR_SPACE_ID=

# Optional shared session storage
SUPABASE_URL=
SUPABASE_ANON_KEY=
SESSION_STORE_SECRET=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# -----------------------------------------------------------------------------
# Server-side route/maintenance secrets
# -----------------------------------------------------------------------------
# OPTIONAL. The scheduled refresh that keeps the Ubisoft session alive is
# driven by .github/workflows/keep-session-alive.yml, which authenticates with
# a GitHub Actions OIDC token and needs no secret here or anywhere else.
#
# CRON_SECRET only adds a second, daily trigger via Vercel Cron, which sends
# Authorization: Bearer <CRON_SECRET>. GET /api/ubisoft-refresh also takes it
# as ?token=<CRON_SECRET>, for an external pinger that can only fetch a plain
# URL. Use CRON_SECRET for that and never DIAGNOSTICS_TOKEN: the URL ends up in
# that service's settings and logs, and CRON_SECRET can only trigger an
# idempotent refresh, while DIAGNOSTICS_TOKEN can also overwrite or clear the
# shared session. Generate one with:  openssl rand -hex 32
CRON_SECRET=

# Operator-only secret. Gates the diagnostics page and, more importantly,
# seeding/clearing the shared Ubisoft session. Treat it as the master key: do
# not put it in a third-party scheduler, a bookmark bar, or a chat window.
DIAGNOSTICS_TOKEN=

# Optional Discord/Slack-compatible webhook. Pinged only when the session
# cannot renew and needs re-seeding by hand. Silence means healthy.
ALERT_WEBHOOK_URL=

# App behavior
DIAGNOSTICS_ENABLED=true
CACHE_TTL_SECONDS=600
RATE_LIMIT_PER_MINUTE=20
