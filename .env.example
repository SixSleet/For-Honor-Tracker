# Optional Steam Web API key (adds owned-game/playtime data)
STEAM_API_KEY=

# Ubisoft UbiServices provider
UBISOFT_ENABLED=false
UBISOFT_TICKET=
UBISOFT_SESSION_ID=
UBISOFT_EMAIL=
UBISOFT_PASSWORD=

# Public Ubisoft client identifier used as Ubi-AppId
UBISOFT_APP_ID=f35adcb5-1911-440c-b1c9-48fdc1701c68
UBISOFT_FORHONOR_SPACE_ID=

# Optional shared session storage
SUPABASE_URL=
SUPABASE_ANON_KEY=
SESSION_STORE_SECRET=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Server-side route/maintenance secrets
CRON_SECRET=
DIAGNOSTICS_TOKEN=
ALERT_WEBHOOK_URL=

# App behavior
DIAGNOSTICS_ENABLED=true
CACHE_TTL_SECONDS=600
RATE_LIMIT_PER_MINUTE=20
